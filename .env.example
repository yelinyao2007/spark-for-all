# Backend only. Copy to .env; never put provider secrets in VITE_* variables.
APP_MODE=live
DATABASE_PATH=data/spark.sqlite3
SESSION_TTL_SECONDS=3600
API_TIMEOUT_SECONDS=25
TURN_TIMEOUT_SECONDS=90
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=https://api.anysearch.com
SEARCH_CACHE_SECONDS=600
SEARCH_DAILY_LIMIT=100
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# The documented client SDK requires appSecret. Disabled until a scoped
# browser credential / sponsor-approved authentication flow is available.
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=
XINGYUN_BROWSER_AUTH_APPROVED=false
COOKIE_SECURE=false
